<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, user-scalable=no">
<title>혜온이 한글 점선 따라쓰기</title>
<style>
:root{--bg:#fffaf3;--card:#fff;--text:#2d2d2d;--muted:#8d857c;--guide:#c9c1b7;--accent:#ff8a65;--ok:#66c7a0;--yellow:#ffd166}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;min-height:100%;font-family:-apple-system,BlinkMacSystemFont,"Apple SD Gothic Neo","Noto Sans KR",sans-serif;background:var(--bg);color:var(--text)}
body{display:flex;justify-content:center}
.app{width:min(100%,760px);padding:14px 14px 28px}
.top{display:flex;align-items:center;justify-content:space-between;gap:10px}
h1{font-size:clamp(22px,6vw,34px);margin:6px 0 10px}
.stars{font-size:20px;background:#fff;border:2px solid #eee3d7;border-radius:20px;padding:7px 11px;white-space:nowrap}
.tabs{display:flex;gap:8px;margin:8px 0 10px}
.tab{flex:1;border:0;border-radius:16px;padding:12px 8px;font-weight:900;font-size:18px;background:#eee}
.tab.active{background:var(--yellow)}
.letters{display:flex;gap:8px;overflow-x:auto;padding:4px 2px 10px;scrollbar-width:none}
.letters::-webkit-scrollbar{display:none}
.letterBtn{min-width:54px;height:54px;border:none;border-radius:17px;background:#fff;box-shadow:0 2px 0 #e7dccd;font-size:28px;font-weight:900}
.letterBtn.active{outline:4px solid var(--yellow);background:#fff7d9}
.card{background:var(--card);border-radius:28px;padding:12px;box-shadow:0 6px 22px rgba(90,60,20,.08)}
.prompt{text-align:center;margin:4px 0 8px}
.big{font-size:clamp(56px,18vw,92px);font-weight:900;line-height:1}
.sub{font-size:18px;font-weight:800;color:#666;margin-top:3px}
.canvasWrap{position:relative;aspect-ratio:1/1;width:100%;max-height:56vh;border:4px solid #eee2d5;border-radius:24px;overflow:hidden;background:#fffdf9}
#guide,#draw{position:absolute;inset:0;width:100%;height:100%;touch-action:none}
#guide{pointer-events:none}
.status{text-align:center;min-height:30px;padding-top:8px;font-weight:900;color:#746b62}
.status.good{color:#278662}
.status.bad{color:#d96b50}
.controls{display:grid;grid-template-columns:1fr 1fr 1fr;gap:9px;margin-top:8px}
.action{border:0;border-radius:18px;padding:14px 8px;font-size:17px;font-weight:900;background:#f3eee7}
.primary{background:var(--accent);color:#fff}
.ok{background:var(--ok);color:#fff}
.tip{text-align:center;color:var(--muted);font-size:14px;margin:10px 4px 2px;line-height:1.5}
.confetti{position:fixed;inset:0;pointer-events:none;overflow:hidden}
.piece{position:absolute;top:-20px;font-size:24px;animation:fall 1.3s linear forwards}
@keyframes fall{to{transform:translateY(110vh) rotate(540deg);opacity:.2}}
@media (max-width:430px){.controls{grid-template-columns:1fr 1fr}.controls .wide{grid-column:1/-1}}
</style>

<link rel="manifest" href="manifest.webmanifest">
<meta name="theme-color" content="#fffaf3">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<link rel="apple-touch-icon" href="icons/icon-192.png">

</head>
<body>
<div class="app">
  <div class="top">
    <h1>🌱 혜온이 한글 따라쓰기</h1>
    <div class="stars">⭐ <span id="starCount">0</span></div>
  </div>

  <div class="tabs">
    <button type="button" class="tab active" data-mode="consonant">자음</button>
    <button type="button" class="tab" data-mode="vowel">모음</button>
    <button type="button" class="tab" data-mode="syllable">글자</button>
  </div>

  <div class="letters" id="letters"></div>

  <div class="card">
    <div class="prompt">
      <div class="big" id="bigLetter">ㄱ</div>
      <div class="sub" id="soundText">기역</div>
    </div>

    <div class="canvasWrap">
      <canvas id="guide"></canvas>
      <canvas id="draw"></canvas>
    </div>

    <div class="status" id="status">점선을 따라 손가락을 움직여 보세요 👆</div>

    <div class="controls">
      <button type="button" class="action" id="listenBtn">🔊 소리</button>
      <button type="button" class="action" id="clearBtn">🧽 다시</button>
      <button type="button" class="action ok" id="doneBtn">⭐ 다 썼어요</button>
      <button type="button" class="action primary wide" id="nextBtn">다음 글자 →</button>
    </div>

    <div class="tip">자음·모음·글자를 선택해서 연습해요.<br>글자 탭에서는 “가 나 다 … 하”까지 따라 쓸 수 있어요.</div>
  </div>
</div>
<div class="confetti" id="confetti"></div>

<script>
const sets={
 consonant:[["ㄱ","기역"],["ㄴ","니은"],["ㄷ","디귿"],["ㄹ","리을"],["ㅁ","미음"],["ㅂ","비읍"],["ㅅ","시옷"],["ㅇ","이응"],["ㅈ","지읒"],["ㅊ","치읓"],["ㅋ","키읔"],["ㅌ","티읕"],["ㅍ","피읖"],["ㅎ","히읗"]],
 vowel:[["ㅏ","아"],["ㅑ","야"],["ㅓ","어"],["ㅕ","여"],["ㅗ","오"],["ㅛ","요"],["ㅜ","우"],["ㅠ","유"],["ㅡ","으"],["ㅣ","이"]],
 syllable:[["가","가"],["나","나"],["다","다"],["라","라"],["마","마"],["바","바"],["사","사"],["아","아"],["자","자"],["차","차"],["카","카"],["타","타"],["파","파"],["하","하"]]
};

// 기본 자모 획 정의
const jamoPaths={
"ㄱ":[[[24,24],[74,24],[74,76]]],
"ㄴ":[[[26,24],[26,76],[76,76]]],
"ㄷ":[[[24,24],[76,24]],[[24,24],[24,76]],[[24,76],[76,76]],[[76,24],[76,76]]],
"ㄹ":[[[24,22],[76,22]],[[76,22],[76,42]],[[76,42],[38,42]],[[38,42],[38,64]],[[38,64],[76,64]],[[76,64],[76,78]],[[76,78],[24,78]]],
"ㅁ":[[[26,24],[74,24]],[[26,24],[26,76]],[[26,76],[74,76]],[[74,24],[74,76]]],
"ㅂ":[[[30,22],[30,78]],[[30,22],[70,22]],[[70,22],[70,78]],[[30,50],[70,50]],[[30,78],[70,78]]],
"ㅅ":[[[50,22],[28,78]],[[50,22],[72,78]]],
"ㅇ":[[[50,22],[66,28],[76,42],[76,58],[66,72],[50,78],[34,72],[24,58],[24,42],[34,28],[50,22]]],
"ㅈ":[[[28,26],[72,26]],[[50,26],[28,78]],[[50,26],[72,78]]],
"ㅊ":[[[38,18],[62,18]],[[28,34],[72,34]],[[50,34],[28,80]],[[50,34],[72,80]]],
"ㅋ":[[[28,22],[28,78]],[[28,28],[72,28]],[[28,52],[76,52]]],
"ㅌ":[[[26,22],[74,22]],[[26,22],[26,78]],[[26,50],[74,50]],[[74,22],[74,78]],[[26,78],[74,78]]],
"ㅍ":[[[26,24],[74,24]],[[38,24],[38,76]],[[26,50],[74,50]],[[62,24],[62,76]],[[26,76],[74,76]]],
"ㅎ":[[[38,18],[62,18]],[[28,34],[72,34]],[[50,46],[65,50],[72,62],[68,74],[58,80],[42,80],[32,74],[28,62],[35,50],[50,46]]],
"ㅏ":[[[42,20],[42,80]],[[42,50],[72,50]]],
"ㅑ":[[[42,20],[42,80]],[[42,40],[72,40]],[[42,60],[72,60]]],
"ㅓ":[[[58,20],[58,80]],[[28,50],[58,50]]],
"ㅕ":[[[58,20],[58,80]],[[28,40],[58,40]],[[28,60],[58,60]]],
"ㅗ":[[[24,62],[76,62]],[[50,24],[50,62]]],
"ㅛ":[[[24,65],[76,65]],[[40,28],[40,65]],[[60,28],[60,65]]],
"ㅜ":[[[24,38],[76,38]],[[50,38],[50,76]]],
"ㅠ":[[[24,35],[76,35]],[[40,35],[40,72]],[[60,35],[60,72]]],
"ㅡ":[[[22,50],[78,50]]],
"ㅣ":[[[50,20],[50,80]]]
};

const syllableLeadMap = {
 "가":"ㄱ","나":"ㄴ","다":"ㄷ","라":"ㄹ","마":"ㅁ","바":"ㅂ","사":"ㅅ",
 "아":"ㅇ","자":"ㅈ","차":"ㅊ","카":"ㅋ","타":"ㅌ","파":"ㅍ","하":"ㅎ"
};

let mode="consonant",idx=0,stars=0,drawing=false,lastProjected=null,completed=false;
let currentStroke=0, strokeSamples=[], visitedStroke=new Set();

const lettersEl=document.getElementById("letters"),
      bigLetter=document.getElementById("bigLetter"),
      soundText=document.getElementById("soundText"),
      statusEl=document.getElementById("status"),
      guide=document.getElementById("guide"),
      draw=document.getElementById("draw"),
      g=guide.getContext("2d"),
      d=draw.getContext("2d");

function current(){ return sets[mode][idx]; }
function toPx(pt,r){ return {x:pt[0]/100*r.width, y:pt[1]/100*r.height}; }

function transformStroke(stroke, sx, sy, tx, ty){
  return stroke.map(([x,y])=>[x*sx+tx, y*sy+ty]);
}

function buildSyllablePaths(char){
  const lead = syllableLeadMap[char];
  const vowel = "ㅏ";
  const leadStrokes = jamoPaths[lead] || [];
  const vowelStrokes = jamoPaths[vowel] || [];

  // 초성은 왼쪽 좁은 영역, 중성 ㅏ는 오른쪽 영역에 배치
  const leadTransformed = leadStrokes.map(st => transformStroke(st, 0.62, 1.0, 0, 0));
  const vowelTransformed = vowelStrokes.map(st => transformStroke(st, 0.58, 1.0, 30, 0));

  return [...leadTransformed, ...vowelTransformed];
}

function currentPaths(){
  if(mode==="syllable") return buildSyllablePaths(current()[0]);
  return jamoPaths[current()[0]];
}

function sizeCanvas(){
  const r=draw.getBoundingClientRect(), ratio=window.devicePixelRatio||1;
  [guide,draw].forEach(c=>{
    c.width=r.width*ratio; c.height=r.height*ratio;
    c.getContext("2d").setTransform(ratio,0,0,ratio,0,0);
  });
  resetLetter();
}

function clearDrawOnly(){
  const r=draw.getBoundingClientRect();
  d.clearRect(0,0,r.width,r.height);
}

function buildStrokeSamples(){
  strokeSamples=[]; visitedStroke=new Set();
  const r=draw.getBoundingClientRect();
  const stroke=currentPaths()[currentStroke];
  let id=0;
  for(let i=0;i<stroke.length-1;i++){
    const a=toPx(stroke[i],r), b=toPx(stroke[i+1],r);
    const len=Math.hypot(b.x-a.x,b.y-a.y);
    const steps=Math.max(3,Math.ceil(len/18));
    for(let s=0;s<=steps;s++){
      const t=s/steps;
      strokeSamples.push({id:id++, x:a.x+(b.x-a.x)*t, y:a.y+(b.y-a.y)*t});
    }
  }
}

function drawArrow(from,to,color="#ff7b54"){
  const vx=to.x-from.x, vy=to.y-from.y;
  const len=Math.hypot(vx,vy)||1;
  const ux=vx/len, uy=vy/len;
  const arrowLen=Math.min(60, Math.max(34, len*0.42));
  const ax=from.x+ux*arrowLen, ay=from.y+uy*arrowLen;
  const size=Math.max(14, guide.getBoundingClientRect().width*0.038);
  const ang=Math.atan2(uy,ux);

  g.strokeStyle=color;
  g.fillStyle=color;
  g.lineWidth=Math.max(6, guide.getBoundingClientRect().width*0.015);
  g.lineCap="round";
  g.beginPath();
  g.moveTo(from.x,from.y);
  g.lineTo(ax,ay);
  g.stroke();

  g.beginPath();
  g.moveTo(ax,ay);
  g.lineTo(ax-size*Math.cos(ang-Math.PI/6), ay-size*Math.sin(ang-Math.PI/6));
  g.lineTo(ax-size*Math.cos(ang+Math.PI/6), ay-size*Math.sin(ang+Math.PI/6));
  g.closePath();
  g.fill();
}

function paintGuide(){
  const r=guide.getBoundingClientRect();
  g.clearRect(0,0,r.width,r.height);

  const all=currentPaths();
  all.forEach((stroke,si)=>{
    const active=(si===currentStroke && !completed);
    g.lineWidth=Math.max(13,r.width*0.036);
    g.strokeStyle=active ? "#b0a79d" : "#e7e1da";
    g.lineCap="round";
    g.lineJoin="round";
    g.setLineDash(active ? [4,20] : [4,18]);

    g.beginPath();
    stroke.forEach((p,i)=>{
      const q=toPx(p,r);
      i ? g.lineTo(q.x,q.y) : g.moveTo(q.x,q.y);
    });
    g.stroke();
    g.setLineDash([]);

    const start=toPx(stroke[0],r);

    g.fillStyle=active ? "#ffd54f" : "#f0ebe5";
    g.strokeStyle=active ? "#d29a00" : "#d8d1cb";
    g.lineWidth=3;
    g.beginPath();
    g.arc(start.x,start.y, active ? 12 : 8, 0, Math.PI*2);
    g.fill();
    g.stroke();

    const offsetX = start.x < r.width/2 ? 32 : -32;
    const offsetY = start.y < r.height/2 ? 32 : -32;
    const bx = start.x + offsetX;
    const by = start.y + offsetY;
    g.fillStyle = active ? "#ff8a65" : "#d9d2cb";
    g.strokeStyle = "#ffffff";
    g.lineWidth = 4;
    g.beginPath();
    g.arc(bx,by, active ? 18 : 15, 0, Math.PI*2);
    g.fill();
    g.stroke();

    g.font=`900 ${Math.max(18,Math.floor(r.width*0.052))}px -apple-system,BlinkMacSystemFont,"Apple SD Gothic Neo","Noto Sans KR",sans-serif`;
    g.textAlign="center";
    g.textBaseline="middle";
    g.fillStyle="#ffffff";
    g.fillText(String(si+1), bx, by+1);

    if(active && stroke.length>1){
      const p0=toPx(stroke[0],r), p1=toPx(stroke[1],r);
      drawArrow(p0,p1,"#ff6f47");
    }
  });
}

function resetLetter(){
  clearDrawOnly();
  completed=false;
  drawing=false;
  lastProjected=null;
  currentStroke=0;
  buildStrokeSamples();
  paintGuide();
  const modeLabel = mode==="syllable" ? "글자" : "획";
  setStatus(`① 1${modeLabel==='글자'?'번째 획':'획'}부터 번호와 화살표를 보고 써요 👆`,"");
}

function renderLetters(){
  lettersEl.innerHTML="";
  sets[mode].forEach((it,i)=>{
    const b=document.createElement("button");
    b.type="button";
    b.className="letterBtn"+(i===idx?" active":"");
    b.textContent=it[0];
    b.addEventListener("click",()=>{ idx=i; update(); resetLetter(); });
    lettersEl.appendChild(b);
  });
}

function update(){
  bigLetter.textContent=current()[0];
  soundText.textContent=current()[1];
  renderLetters();
  paintGuide();
  requestAnimationFrame(()=>{
    const a=lettersEl.querySelector(".active");
    if(a) a.scrollIntoView({behavior:"smooth", inline:"center", block:"nearest"});
  });
}

function pointerPos(e){
  const r=draw.getBoundingClientRect();
  return {x:e.clientX-r.left, y:e.clientY-r.top};
}

function nearestOnSegment(p,a,b){
  const vx=b.x-a.x, vy=b.y-a.y, wx=p.x-a.x, wy=p.y-a.y;
  const len2=vx*vx+vy*vy;
  let t=len2 ? ((wx*vx+wy*vy)/len2) : 0;
  t=Math.max(0,Math.min(1,t));
  const q={x:a.x+t*vx, y:a.y+t*vy};
  return {q, dist:Math.hypot(p.x-q.x,p.y-q.y)};
}

function nearestOnActiveStroke(p){
  const r=draw.getBoundingClientRect();
  const stroke=currentPaths()[currentStroke];
  let best={q:null,dist:Infinity};
  for(let i=0;i<stroke.length-1;i++){
    const a=toPx(stroke[i],r), b=toPx(stroke[i+1],r);
    const n=nearestOnSegment(p,a,b);
    if(n.dist<best.dist) best=n;
  }
  return best;
}

function threshold(){
  return Math.max(24, draw.getBoundingClientRect().width*0.07);
}

function markVisited(q){
  const radius=threshold();
  for(const s of strokeSamples){
    if(Math.hypot(q.x-s.x, q.y-s.y) <= radius) visitedStroke.add(s.id);
  }
}

function strokeRatio(){
  return strokeSamples.length ? visitedStroke.size/strokeSamples.length : 0;
}

function setStatus(msg,cls){
  statusEl.textContent=msg;
  statusEl.className="status"+(cls ? " "+cls : "");
}

function finishStroke(){
  if(currentStroke < currentPaths().length-1){
    currentStroke++;
    buildStrokeSamples();
    paintGuide();
    setStatus(`${currentStroke}획 완료! 이제 ${currentStroke+1}획이에요 ⭐`,"good");
  }else{
    finishLetter();
  }
}

function start(e){
  if(completed) return;
  drawing=true;
  const n=nearestOnActiveStroke(pointerPos(e));
  if(n.dist<=threshold()){
    lastProjected=n.q;
    markVisited(n.q);
    setStatus(`${currentStroke+1}획 좋아요! 화살표 방향으로 가요 😊`,"good");
  }else{
    lastProjected=null;
    setStatus(`${currentStroke+1}획 시작점 근처에서 다시 시작해요 🙂`,"bad");
  }
  e.preventDefault();
}

function move(e){
  if(!drawing || completed) return;
  const n=nearestOnActiveStroke(pointerPos(e));
  if(n.dist<=threshold()){
    if(lastProjected){
      d.strokeStyle="#ff8a65";
      d.lineWidth=Math.max(12, draw.getBoundingClientRect().width*0.035);
      d.lineCap="round";
      d.lineJoin="round";
      d.beginPath();
      d.moveTo(lastProjected.x,lastProjected.y);
      d.lineTo(n.q.x,n.q.y);
      d.stroke();
    }
    lastProjected=n.q;
    markVisited(n.q);
    const pct=Math.round(strokeRatio()*100);
    setStatus(`${currentStroke+1}획 ${pct}% 👏`,"good");
    if(strokeRatio()>=1.0) finishStroke();
  }else{
    lastProjected=null;
    setStatus(`${currentStroke+1}획 점선에서 벗어났어요 👆`,"bad");
  }
  e.preventDefault();
}

function end(){
  drawing=false;
  lastProjected=null;
}

draw.addEventListener("pointerdown",start);
draw.addEventListener("pointermove",move);
draw.addEventListener("pointerup",end);
draw.addEventListener("pointercancel",end);

function playDing(){
  try{
    const AC=window.AudioContext||window.webkitAudioContext;
    if(!AC) return;
    const ac=new AC(), gain=ac.createGain(), o1=ac.createOscillator(), o2=ac.createOscillator();
    gain.connect(ac.destination); o1.connect(gain); o2.connect(gain);
    o1.type="sine"; o2.type="sine";
    o1.frequency.setValueAtTime(880,ac.currentTime);
    o2.frequency.setValueAtTime(1320,ac.currentTime+0.09);
    gain.gain.setValueAtTime(0.0001,ac.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.28,ac.currentTime+0.01);
    gain.gain.exponentialRampToValueAtTime(0.0001,ac.currentTime+0.35);
    o1.start(); o2.start(ac.currentTime+0.08);
    o1.stop(ac.currentTime+0.28); o2.stop(ac.currentTime+0.38);
    setTimeout(()=>ac.close(),500);
  }catch(e){}
}

function speakSequence(){
  if(!("speechSynthesis" in window)) return;
  setTimeout(()=>{
    speechSynthesis.cancel();
    const first=new SpeechSynthesisUtterance(current()[1]);
    first.lang="ko-KR";
    first.rate=0.72;
    first.pitch=1.12;
    first.onend=()=>{
      const cheer=new SpeechSynthesisUtterance("혜온이 엄청 멋저요!");
      cheer.lang="ko-KR";
      cheer.rate=0.82;
      cheer.pitch=1.16;
      speechSynthesis.speak(cheer);
    };
    speechSynthesis.speak(first);
  },430);
}

function celebrate(){
  const c=document.getElementById("confetti"), icons=["⭐","🌸","💛","🎈","✨"];
  for(let i=0;i<16;i++){
    const s=document.createElement("div");
    s.className="piece";
    s.textContent=icons[Math.floor(Math.random()*icons.length)];
    s.style.left=Math.random()*100+"vw";
    s.style.animationDelay=Math.random()*0.2+"s";
    c.appendChild(s);
    setTimeout(()=>s.remove(),1500);
  }
}

function finishLetter(){
  if(completed) return;
  completed=true;
  drawing=false;
  lastProjected=null;
  stars++;
  document.getElementById("starCount").textContent=stars;
  paintGuide();
  setStatus(`완성! ${current()[0]} ⭐`,"good");
  celebrate();
  playDing();
  speakSequence();
}

document.querySelectorAll(".tab").forEach(t=>t.addEventListener("click",()=>{
  mode=t.dataset.mode;
  idx=0;
  document.querySelectorAll(".tab").forEach(x=>x.classList.toggle("active",x===t));
  update();
  resetLetter();
}));

document.getElementById("clearBtn").addEventListener("click",resetLetter);

document.getElementById("listenBtn").addEventListener("click",()=>{
  if(!("speechSynthesis" in window)) return;
  speechSynthesis.cancel();
  const u=new SpeechSynthesisUtterance(current()[1]);
  u.lang="ko-KR";
  u.rate=0.72;
  u.pitch=1.12;
  speechSynthesis.speak(u);
});

document.getElementById("nextBtn").addEventListener("click",()=>{
  idx=(idx+1)%sets[mode].length;
  update();
  resetLetter();
});

document.getElementById("doneBtn").addEventListener("click",()=>{
  if(completed){
    playDing();
    speakSequence();
  }else{
    setStatus(`${currentStroke+1}획을 100% 따라 써야 해요 😊`,"bad");
  }
});

window.addEventListener("resize",sizeCanvas);
renderLetters();
update();
setTimeout(sizeCanvas,60);
</script>

<script>
if ("serviceWorker" in navigator) {
  window.addEventListener("load", () => {
    navigator.serviceWorker.register("./sw.js").catch(() => {});
  });
}
</script>

